# ---------------- Friday settings ----------------
# Copy to .env (or ~/Library/Application Support/Friday/.env) and edit.

# How Friday addresses you
JARVIS_USER_TITLE_EN=sir
JARVIS_USER_TITLE_HI=सर

# ---- Brain: local model via Ollama (offline) ----
# qwen2.5:7b (16 GB Mac) · qwen2.5:14b (32 GB+, better Hindi) · qwen2.5:3b (8 GB Mac)
JARVIS_LOCAL_MODEL=qwen2.5:7b
OLLAMA_HOST=http://127.0.0.1:11434
JARVIS_LLM_TIMEOUT=90
# Context window in tokens (tool schemas use ~3k). 16384 needs ~1 GB extra RAM; use 8192 on 8 GB Macs
JARVIS_NUM_CTX=16384
# Conversation turns the model remembers (older ones are dropped)
JARVIS_MAX_HISTORY=8
# 0 = most literal and reliable for tool use, higher = more varied wording
JARVIS_TEMPERATURE=0.2

# ---- Ears: Whisper (local) ----
# small = good Hindi (recommended) · medium = best Hindi, slower · base = fast, weak Hindi
WHISPER_MODEL=small
WHISPER_THREADS=8
# int8 = fastest on CPU · float32 = most accurate, slower
WHISPER_COMPUTE=int8
# auto = detect Hindi/English each time · hi = always Hindi · en = always English
JARVIS_LANGUAGE=auto
# Raise if recording never stops (noisy room); lower if it cuts you off
SILENCE_THRESHOLD=0.008
SILENCE_DURATION=0.7
CONVERSATION_TIMEOUT=8
# Longest single command Friday records (seconds)
MAX_RECORD_SECONDS=15
# Threshold follows the room's background noise (never goes below SILENCE_THRESHOLD)
JARVIS_ADAPTIVE_NOISE=true
# Ignore sounds with less voice than this (clicks, coughs, door slams)
MIN_SPEECH_SECONDS=0.15
# Pause after Friday speaks, so it doesn't hear its own voice tail
POST_SPEAK_PAUSE=0.3
# Leave empty for the default mic; run `python debug_audio.py` to list devices
MIC_DEVICE=
# true = always listening for "Friday"; false = only orb click / Option+J
JARVIS_WAKE_WORD=true

# ---- Mouth: neural voices (needs internet; falls back to macOS voices offline) ----
JARVIS_TTS=neural
JARVIS_VOICE_EN=en-GB-RyanNeural
JARVIS_VOICE_HI=hi-IN-MadhurNeural
JARVIS_VOICE_RATE=+4%
JARVIS_VOICE_PITCH=-4Hz
# Voice clips are cached on disk; the oldest are deleted above this size (MB)
JARVIS_CACHE_MAX_MB=50
# Offline fallback voices (System Settings > Accessibility > Spoken Content to add more)
JARVIS_SAY_VOICE_EN=Daniel
JARVIS_SAY_VOICE_HI=Lekha
JARVIS_SAY_RATE=185

# ---- Behaviour ----
# Ask before sending email, running shell commands, or trashing files
JARVIS_SAFE_MODE=true
# Global push-to-talk key: modifiers (option/cmd/ctrl/shift) + one key, e.g. option+j, cmd+shift+space
JARVIS_HOTKEY=option+j
# true = write what you said into the log file (useful for debugging, but it is private text)
JARVIS_LOG_TRANSCRIPTS=false
